{
  // 프론트엔드(Next.js) Worker — 기존 백엔드 API Worker("tryon-marketplace")와 이름이 겹치지 않게 따로 둡니다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "tryon-marketplace-web",
  "compatibility_date": "2025-12-01",
  // 접속 주소(https://tryon-marketplace-web.choisunfriend.workers.dev)를 배포 때마다 켜둡니다
  "workers_dev": true,
  // 브랜치별 미리보기 주소는 쓰지 않음
  "preview_urls": false,
  // global_fetch_strictly_public: 같은 계정의 다른 workers.dev(백엔드 API)를 fetch 할 때 막히지 않게
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tryon-marketplace-web"
    }
  ],
  // 상품 이미지·3D 파일 저장소 — 관리자 업로드(/api/assets/upload)와 파일 제공(/api/assets/...)에 씁니다
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "tryon-marketplace-assets"
    }
  ],
  // GYEOL 앱처럼 이 마켓플레이스를 iframe으로 띄울 수 있는 주소들 (공백으로 구분)
  // src/middleware.ts 의 CSP frame-ancestors 에 들어갑니다
  "vars": {
    "FRAME_ANCESTORS": "https://*.choisunfriend.workers.dev https://choisunfriend.github.io"
  },
  "observability": { "enabled": true }
}
